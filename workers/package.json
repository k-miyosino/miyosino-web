{
  "name": "miyosino-api-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:contact": "wrangler dev --config wrangler.contact.toml",
    "deploy:contact": "wrangler deploy --config wrangler.contact.toml",
    "dev:contents": "wrangler dev --config wrangler.contents.toml",
    "deploy:contents": "wrangler deploy --config wrangler.contents.toml",
    "dev:auth": "wrangler dev --config wrangler.auth.toml",
    "deploy:auth": "wrangler deploy --config wrangler.auth.toml",
    "dev:announcements": "wrangler dev --config wrangler.announcements.toml",
    "deploy:announcements": "wrangler deploy --config wrangler.announcements.toml",
    "dev:circulars": "wrangler dev --config wrangler.circulars.toml",
    "deploy:circulars": "wrangler deploy --config wrangler.circulars.toml",
    "dev:minutes": "wrangler dev --config wrangler.minutes.toml",
    "deploy:minutes": "wrangler deploy --config wrangler.minutes.toml",
    "dev:events": "wrangler dev --config wrangler.events.toml",
    "deploy:events": "wrangler deploy --config wrangler.events.toml",
    "dev:applications": "wrangler dev --config wrangler.applications.toml",
    "deploy:applications": "wrangler deploy --config wrangler.applications.toml",
    "dev:places": "wrangler dev --config wrangler.places.toml",
    "deploy:places": "wrangler deploy --config wrangler.places.toml",
    "dev:chat": "wrangler dev --config wrangler.chat.toml",
    "deploy:chat": "wrangler deploy --config wrangler.chat.toml",
    "chat:on": "wrangler d1 execute miyosino-chat --remote --config wrangler.chat.toml --command \"INSERT INTO chat_settings (key, value) VALUES ('enabled', '1') ON CONFLICT (key) DO UPDATE SET value = '1'\"",
    "chat:off": "wrangler d1 execute miyosino-chat --remote --config wrangler.chat.toml --command \"INSERT INTO chat_settings (key, value) VALUES ('enabled', '0') ON CONFLICT (key) DO UPDATE SET value = '0'\"",
    "chat:limits": "node scripts/set-chat-limits.mjs",
    "chat:status": "wrangler d1 execute miyosino-chat --remote --config wrangler.chat.toml --command \"SELECT key, value FROM chat_settings ORDER BY key\"",
    "chat:log": "node scripts/chat-admin.mjs log",
    "chat:log-days": "node scripts/chat-admin.mjs log-days",
    "chat:rating": "node scripts/chat-admin.mjs rating",
    "chat:logs": "node scripts/chat-admin.mjs logs",
    "chat:ratings": "node scripts/chat-admin.mjs ratings",
    "chat:eval": "node scripts/chat-eval.mjs",
    "set-jwt-secret": "bash scripts/set-jwt-secret.sh",
    "generate-jwt-secret": "bash scripts/generate-jwt-secret.sh",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "typescript": "^5",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0"
  }
}
